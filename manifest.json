{
  "manifest_version": 3,
  "name": "Script Personal Data",
  "version": "1.0.0",
  "description": "Preenchimento rápido e local de formulários de processos seletivos, compatível com sites em React, Vue e Angular.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "script-personal-data@pedroweb.dev",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "120.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}